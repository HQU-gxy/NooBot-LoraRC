CONFIG_IDF_TARGET="esp32s2"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=y
CONFIG_ESP_RMAKER_OTA_AUTOFETCH=n
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_LEDC_CTRL_FUNC_IN_IRAM=y
