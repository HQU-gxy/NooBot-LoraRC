CONFIG_TFT_LOAD_GFXFF=n
CONFIG_TFT_SMOOTH_FONT=n
CONFIG_DISABLE_WARNINGS=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_24=y
CONFIG_FMB_COMM_MODE_TCP_EN=n
CONFIG_FMB_COMM_MODE_RTU_EN=n
CONFIG_ESP_SECURE_CERT_DS_PERIPHERAL=n
